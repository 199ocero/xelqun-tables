{
    "name": "@xelqun/tables",
    "version": "0.8.0",
    "description": "Vue renderer for Xelqun Tables: PHP-defined, schema-driven tables for Laravel + Inertia.",
    "license": "MIT",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/199ocero/xelqun-tables.git"
    },
    "files": [
        "resources/js",
        "resources/css"
    ],
    "type": "module",
    "sideEffects": [
        "*.css",
        "*.vue"
    ],
    "exports": {
        ".": "./resources/js/index.ts",
        "./style.css": "./resources/css/xelqun-tables.css"
    },
    "scripts": {
