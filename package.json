        "@vue/test-utils": "^2.4.6",
        "@xelqun/forms": "^0.10.0",
        "happy-dom": "^21.0.4",
        "reka-ui": "^2.11.0",
        "typescript": "^5.2.2",
        "vite-plus": "1.4.0",
        "vitest": "^5.0.5",
        "vue": "^3.5.13",
        "vue-tsc": "^3.3.13"
    },
    "peerDependencies": {
        "@inertiajs/vue3": "^3.0.0",
        "@xelqun/forms": "^0.10.0",
        "reka-ui": "^2.11.0",
        "vue": "^3.5.0"
    },
